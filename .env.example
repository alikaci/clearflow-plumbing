# Optional public site origin.
#
# Leave this empty while no public domain is owned. When empty, the build omits
# canonical URLs, Open Graph URLs, the social image and the robots Host value
# instead of pointing at localhost or an assumed/unowned domain. robots noindex
# stays active regardless.
#
# After deploying to a real domain, set the exact origin (no trailing slash,
# http or https only) and rebuild, because NEXT_PUBLIC_ values are inlined at
# build time. For example:
#   NEXT_PUBLIC_SITE_URL=https://your-real-domain.com
#
# Values that are missing, malformed, not http(s), loopback (localhost, 127.*,
# ::1, 0.0.0.0) or on a reserved documentation TLD (.example, .invalid, .test,
# .localhost) are rejected so no unverified origin is ever published. A set but
# invalid value makes the build print a warning, and the tags above are omitted.
# The example value below is documentation-only and must NOT be used as-is.
NEXT_PUBLIC_SITE_URL=